# Shared state (Upstash Redis REST). Without these, an in-memory store is used (local dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Session signing for the merchant console (32+ characters, required in production).
SESSION_SECRET=

# Merchant console passcode. Defaults to "chronos-demo", which the login page shows publicly.
MERCHANT_PASSCODE=

# Stripe sandbox (optional). Must be a test key; live keys are refused at startup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: canonical public URL used for Stripe redirect URLs.
APP_URL=
